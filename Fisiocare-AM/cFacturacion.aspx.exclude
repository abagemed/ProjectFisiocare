                ErrorMessage="*" ValidationGroup="cancel"></asp:RequiredFieldValidator><br />
            <br />
            <img src="imagenes/bullet_disk.png" /><asp:Button ID="Button3" runat="server" ForeColor="Red" Text="Grabar Cancelacion" Font-Size="9pt" Width="121px" ValidationGroup="cancel" />
            <img src="imagenes/cancel.png" /><asp:Button ID="Button5" runat="server" ForeColor="Red" Text="Cancelar" Width="68px" Font-Size="9pt" /></asp:Panel>
        <CR:CrystalReportSource ID="origen_reporte" runat="server">
        </CR:CrystalReportSource>
        <input id="hfModFac" type="hidden" runat="server" style="width: 1px" />
        <input id="hfValFacturar" style="width: 1px" type="hidden" runat="server" />
        <input id="hfidDatosFac" runat="server" style="width: 1px" type="hidden" />
        <ajaxToolkit:FilteredTextBoxExtender ID="FilteredTextBoxExtender3" runat="server"
            FilterType="Numbers" TargetControlID="txtNfac">
        </ajaxToolkit:FilteredTextBoxExtender>
        &nbsp;
        &nbsp;&nbsp; &nbsp; &nbsp;
        <CR:CrystalReportViewer ID="visor_reporte" runat="server" AutoDataBind="true" />
        </div>
    
    </form></center>
</body>
</html>
