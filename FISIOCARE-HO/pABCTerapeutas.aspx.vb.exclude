        Else
            ModExpedienteFg = 0
        End If

        If eft_2.Checked = True Then
            ModEtapaFg = 1
        Else
            ModEtapaFg = 0
        End If


        If ChkBoxPDiagnosticoPAlta.Checked = True Then
            MDiagnostico = 1
        Else
            MDiagnostico = 0
        End If

        'Ab 28/03/2019
        If ChkBoxPBloqueoAlta.Checked = True Then
            APermisoBloqueos = 1
        Else
            APermisoBloqueos = 0
        End If

        'Ab 23/04/2019
        If ChkBoxPAgruparConceptosAlta.Checked = True Then
            APermisoAgruparConceptos = 1
        Else
            APermisoAgruparConceptos = 0
        End If



        Dim rol As String = ""
        If rol2.Value = 1 Then
            rol = "RX"
        End If
        If rol2.Value = 2 Then
            rol = "RE"
        End If
        If rol2.Value = 3 Then
            rol = "DR"
        End If
        If rol2.Value = 4 Then
            rol = "CX"
        End If
        If rol2.Value = 5 Then
            rol = "AN"
        End If
        If rol2.Value = 6 Then
            rol = "AY"
        End If

        'validacion de formato de correo
        Try

            Dim mail As New System.Net.Mail.MailAddress(txtLogin2.Text)

            strSQL = "SELECT codigoUsuario  FROM [" & clsDatos.BaseDatos & "].[dbo].[CatUsuarios] " & _
                     "where login='" & txtLogin2.Text & "' and status=1"
            If clsDatos.cargatabla(strSQL, dt) = 0 Then
                If dt.Rows.Count > 0 Then
                    LblMensajeAdvertencia.Text = "El nombre de usuario ya existe o usuario no valido"
                    PanelAdvertencia.Visible = True
                    PanelAdvertencia.Focus()
                    Exit Sub
                End If
            End If
            strSQL = "insert into [" & clsDatos.BaseDatos & "].[dbo].[CatUsuarios] (nombre,primerApellido,segundoApellido,especialidad,cedula,login,password,rol,status,codigoEmpresa,firma,email) " & _
                        "values('" & txtNombre2.Text.ToUpper & "','" & txtPaterno2.Text.ToUpper & "','" & txtMaterno2.Text.ToUpper & "','" & txtEspecialidad2.Text.ToUpper & "','" & txtCedula2.Text & "','" & txtLogin2.Text & "','" & txtPass2.Text & "','" & rol & "',1," & Session("codigoEmpresa") & ",'" & firma_alta.Value & "','" & txtCorreoA.Text & "' )"

            clsDatos.cargaComando(strSQL)
            If clsDatos.ejecutar = 0 Then
                LblMensajeAviso.Text = "Se agrego el nuevo usuario correctamente"
                PanelAvisos.Visible = True
                PanelAvisos.Focus()
                CargarGrdUsuarios()
                limpiarvariables()
            Else
                LblMensajeCritico.Text = clsDatos.MensajeError
                PanelCritico.Visible = True
            End If

            Dim IUsuario As String = ""
            strSQL = "select top 1 codigoUsuario from [" & clsDatos.BaseDatos & "].[dbo].[CatUsuarios] " & _
                             " order by codigoUsuario desc"
            If clsDatos.cargatabla(strSQL, dt) = 0 Then

                If dt.Rows.Count > 0 Then
                    IUsuario = dt.Rows(0).Item("codigoUsuario")

                Else
                    LblMensajeAdvertencia.Text = "Error 1278: " + clsDatos.MensajeError
                    PanelAdvertencia.Visible = True
                    PanelAdvertencia.Focus()

                End If
            End If


            strSQL = "insert into [" & clsDatos.BaseDatos & "].[dbo].[AgPermisos] (codigoUsuario, agenda, expediente, facturacion, pagos, EditarPagos, configuracion, reportes, borrarAbonos, otro2,codigoEmpresa, AgregarCPago, EliminarCpago, ModEtapaFinalizada, ModExpedienteEFinalizada,PADiagnostico,PermisoBloqueos,AgruparFactura) " & _
             "values('" & IUsuario & "',1,'" & expedienteg & "','" & facturaciong & "','" & pagosg & "','" & EditarPagosg & "','" & configuraciong & "','" & reportesg & "','" & borrarAbonosg & "',1," & Session("codigoEmpresa") & ",'" & agregarconceptog & "','" & borrarconceptog & "','" & ModEtapaFg & "','" & ModExpedienteFg & "','" & MDiagnostico & "', '" & APermisoBloqueos & "','" & APermisoAgruparConceptos & "') "

            clsDatos.cargaComando(strSQL)
            If clsDatos.ejecutar = 0 Then
                LblMensajeAviso.Text = "Se agrego el nuevo usuario correctamente"
                PanelAvisos.Visible = True
                PanelAvisos.Focus()
                CargarGrdUsuarios()
                limpiarvariables()
            Else
                LblMensajeCritico.Text = clsDatos.MensajeError
                PanelCritico.Visible = True
            End If
        Catch ex As Exception

            LblMensajeAdvertencia.Text = " Formato de correo no valido, ejemplo: usuario@agemed.com.mx"
            PanelAdvertencia.Visible = True
            PanelAdvertencia.Focus()
            Exit Sub
        End Try
    End Sub
    Protected Sub limpiarvariables()
        txtCedula2.Text = ""
        txtEspecialidad2.Text = ""
        txtLogin2.Text = ""
        txtMaterno2.Text = ""
        txtNombre2.Text = ""
        txtPass2.Text = ""
        txtPaterno2.Text = ""
        ChkBoxExpedienteg.Checked = True
        ChkBoxConfiguraciong.Checked = True
        ChkBoxPagosg.Checked = True
        ChkBoxFacturaciong.Checked = True
        ChkBoxReportesg.Checked = True
        ChkBoxBorrarAbonosg.Checked = True
        firma_editar.Value = ""
        txtCorreoA.Text = ""

    End Sub
End Class