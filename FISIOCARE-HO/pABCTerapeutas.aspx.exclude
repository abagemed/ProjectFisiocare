                        <div class="form-group">
                            <input class="form-control hidden" id="firma_alta" value="" runat="server" />
                        </div>
                        <div class="form-group contenedor_firma_alta">
                            <label class="col-md-4">Firma</label>
                            <div class="input-group col-md-8">
                                <div class="wrapper-signature">
                                  <canvas id="canvas_firma_alta" class="signature-pad" width="400" height="200"></canvas>
                                </div>
                                <div style="margin: -20px 0 20px 0;" id="mensaje_canvas_alta">
                                    
                                </div>
                                <button type="button" id="draw_alta" class="btn btn-success"><i class="fa fa-pencil"></i> Dibujar</button>
                                <button type="button" id="erase_alta" class="btn btn-warning"><i class="fa fa-eraser"></i> Borrar</button>
                                <button type="button" id="clear_alta" class="btn btn-info"><i class="fa fa-close"></i> Limpiar</button>

                            </div>
                       </div>     
                        
                         
                                
                        
                        
                        
                                                               
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-8">
                            <asp:Button ID="btnGuardar2" runat="server" Text="Guardar" class="btn btn-success btn-block" CausesValidation="true" ValidationGroup="gNuevoDatos" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-default btn-block" data-dismiss="modal" aria-hidden="true">Cancelar</button>
                        </div>
                    </div>
                    <input type="hidden" name="Alta" value="1">
                </div>
            </div>
       </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/signature_pad@2.3.2/dist/signature_pad.min.js"></script>
    <script>
        $(document).ready(function () {
            Update();
        })
        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(Update);
        function Update() {

            $('.contenedor_firma_alta').addClass('hidden');
            $('.contenedor_firma_editar').addClass('hidden');

            if ($('#<%=rol1.ClientID%> option:selected').val() == 3) {
                $('.contenedor_firma_editar').removeClass('hidden');
            }

            if ($('#<%=rol2.ClientID%> option:selected').val() == 3) {
                $('.contenedor_firma_alta').removeClass('hidden');
            }

            //Ocultar firmas
            $('#<%=rol1.ClientID%>').change(function () {
                if ($(this).val() == 3) {
                    $('.contenedor_firma_editar').removeClass('hidden');
                }
                else {
                    $('.contenedor_firma_editar').addClass('hidden');
                }
            });

            $('#<%=rol2.ClientID%>').change(function () {
                if ($(this).val() == 3) {
                    $('.contenedor_firma_alta').removeClass('hidden');
                }
                else {
                    $('.contenedor_firma_alta').addClass('hidden');
                }
            });




            var grid = document.getElementById('<%= GdUsuarios.ClientID%>');
            var tbody = grid.getElementsByTagName("tbody")[0]; //gets the first and only tbody
            var firstTr = tbody.getElementsByTagName("tr")[0]; //gets the first tr, hopefully contains the th's

            tbody.removeChild(firstTr); //remove tr's from table

            var newTh = document.createElement('thead'); //creates thead
            newTh.appendChild(firstTr); //puts ths in thead
            grid.insertBefore(newTh, tbody); //puts thead behore tbody
            $(document.getElementById('<%= GdUsuarios.ClientID%>')).DataTable({
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.10.19/i18n/Spanish.json"
                },
                "ordering": true,
            });
            $('#mensaje_canvas_alta').html('Modo dibujar activado');
            $('#mensaje_canvas_editar').html('Modo dibujar activado');


            var canvas_alta = document.getElementById('canvas_firma_alta');
            var canvas_editar = document.getElementById('canvas_firma_editar');


            var context = canvas_editar.getContext("2d");
            if ($('#<%=firma_editar.ClientID%>').val() != '')
            {
                var img = new Image();
                img.src = $('#<%=firma_editar.ClientID%>').val();
                img.onload = function () {
                    context.drawImage(img, 0, 0);
                };
            }
            
            // Adjust canvas coordinate space taking into account pixel ratio,
            // to make it look crisp on mobile devices.
            // This also causes canvas to be cleared.
            function resizeCanvas() {
                // When zoomed out to less than 100%, for some very strange reason,
                // some browsers report devicePixelRatio as less than 1
                // and only part of the canvas is cleared then.
                var ratio = Math.max(window.devicePixelRatio || 1, 1);
                canvas_alta.width = canvas_alta.offsetWidth * ratio;
                canvas_alta.height = canvas_alta.offsetHeight * ratio;
                canvas_alta.getContext("2d").scale(ratio, ratio);

                canvas_editar.width = canvas_editar.offsetWidth * ratio;
                canvas_editar.height = canvas_editar.offsetHeight * ratio;
                canvas_editar.getContext("2d").scale(ratio, ratio);
            }

            window.onresize = resizeCanvas;
            //resizeCanvas();

            ////// Declaración del objeto
            var signaturePad = new SignaturePad(canvas_alta, {
                backgroundColor: 'rgb(255, 255, 255)' // necessary for saving image as JPEG; can be removed is only saving as PNG or SVG
            });

            var signaturePad_editar = new SignaturePad(canvas_editar, {
                backgroundColor: 'rgb(255, 255, 255)' // necessary for saving image as JPEG; can be removed is only saving as PNG or SVG
            });

            ////////// Evento clic en el canvas
            document.getElementById('canvas_firma_alta').addEventListener('click', function () {
                if (signaturePad.isEmpty()) {
                    return alert("Por favor dibuja la firma.");
                }
                var dataURL = signaturePad.toDataURL();
                var data = signaturePad.toDataURL('image/png');
                $('#<%=firma_alta.ClientID%>').val(data);
                console.log(data);
            });

            document.getElementById('canvas_firma_editar').addEventListener('click', function () {
                if (signaturePad_editar.isEmpty()) {
                    return alert("Por favor dibuja la firma.");
                }
                var dataURL = signaturePad_editar.toDataURL();
                var data = signaturePad_editar.toDataURL('image/png');
                $('#<%=firma_editar.ClientID%>').val(data);
                console.log(data);
            });

            ///////////Botón limpiar
            document.getElementById('clear_alta').addEventListener('click', function () {
                signaturePad.clear();
                $('#<%=firma_alta.ClientID%>').val('');
            });

            document.getElementById('clear_editar').addEventListener('click', function () {
                signaturePad_editar.clear();
                $('#<%=firma_editar.ClientID%>').val('');
                console.log('Click en limpiar de editar');
            });

            //////Botón dibular
            document.getElementById('draw_alta').addEventListener('click', function () {
                var ctx = canvas_alta.getContext('2d');
                console.log(ctx.globalCompositeOperation);
                ctx.globalCompositeOperation = 'source-over'; // default value
                $('#mensaje_canvas_alta').html('Modo dibujar activado');
            });
            document.getElementById('draw_editar').addEventListener('click', function () {
                var ctx = canvas_editar.getContext('2d');
                console.log(ctx.globalCompositeOperation);
                ctx.globalCompositeOperation = 'source-over'; // default value
                $('#mensaje_canvas_editar').html('Modo dibujar activado');
            });

            /////////Botón borrar
            document.getElementById('erase_alta').addEventListener('click', function () {
                var ctx = canvas_alta.getContext('2d');
                ctx.globalCompositeOperation = 'destination-out';
                $('#mensaje_canvas_alta').html('Modo borar activado');
            });
            document.getElementById('erase_editar').addEventListener('click', function () {
                var ctx = canvas_editar.getContext('2d');
                ctx.globalCompositeOperation = 'destination-out';
                $('#mensaje_canvas_editar').html('Modo borar activado');
            });

            function dataURLToBlob(dataURL) {
                // Code taken from https://github.com/ebidel/filer.js
                var parts = dataURL.split(';base64,');
                var contentType = parts[0].split(":")[1];
                var raw = window.atob(parts[1]);
                var rawLength = raw.length;
                var uInt8Array = new Uint8Array(rawLength);

                for (var i = 0; i < rawLength; ++i) {
                    uInt8Array[i] = raw.charCodeAt(i);
                }
                return new Blob([uInt8Array], { type: contentType });
            }


        }
</script>




</asp:Content>
